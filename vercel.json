{
  "buildCommand": "mkdir -p public && cp -r assets sw.js manifest.json public/",
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "{index.php,config/**,includes/**,pages/**,database/**}"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/api/ping\\.php(.*)$",
      "dest": "/api/ping.php$1"
    },
    {
      "src": "^/api/sync\\.php(.*)$",
      "dest": "/api/sync.php$1"
    },
    {
      "src": "^/pages/([a-zA-Z0-9_-]+\\.php)(.*)$",
      "dest": "/api/vercel_router.php?__route=pages/$1"
    },
    {
      "src": "^/(index\\.php)?$",
      "dest": "/api/vercel_router.php?__route=index.php"
    }
  ]
}
